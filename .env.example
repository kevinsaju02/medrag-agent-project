APP_NAME=MedRAG Agent
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DEFAULT_VECTOR_STORE=faiss
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
